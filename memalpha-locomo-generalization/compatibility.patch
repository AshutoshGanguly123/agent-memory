@@ -106,7 +111,23 @@ class Memory:
 
     def _generate_memory_id(self) -> str:
         """Generate a unique ID for a memory item."""
-        return str(uuid.uuid4())[:4]  # Using first 4 characters of UUID
+        existing = {key for item in self.semantic + self.episodic for key in item}
+        if len(existing) >= 65536:
+            raise ValueError("Four-character memory ID space exhausted")
+        if self.id_seed is not None:
+            # IDs are opaque. Deriving the initial candidate from the canonical
+            # pre-operation state makes replay independent of process RNG state.
+            state = json.dumps([self.core, self.semantic, self.episodic],
+                               sort_keys=True, ensure_ascii=False)
+            start = int(hashlib.sha256((str(self.id_seed) + state).encode()).hexdigest()[:4], 16)
+            for offset in range(65536):
+                candidate = f"{(start + offset) % 65536:04x}"
+                if candidate not in existing:
+                    return candidate
+        while True:
+            candidate = str(uuid.uuid4())[:4]
+            if candidate not in existing:
+                return candidate
 
